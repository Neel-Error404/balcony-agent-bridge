# Optional dispatcher only. Do not add Azure or signing-key variables.
BALCONY_SYSTEM_ID=node-a
BALCONY_AUTHORIZED_NODE_IDS=node-b,node-c
BALCONY_BRIDGE_DB_PATH=C:\path\to\agent-bridge\data\bridge.sqlite3
BALCONY_DISPATCHER_PROJECTS_PATH=C:\path\to\agent-bridge\config\dispatcher-projects.json
BALCONY_CODEX_EXECUTABLE=C:\path\to\approved-native-codex.exe
BALCONY_CODEX_EXECUTABLE_SHA256=replace-with-approved-lowercase-sha256
BALCONY_CODEX_CODE_MODE_HOST_EXECUTABLE=C:\path\to\approved-code-mode-host.exe
BALCONY_CODEX_CODE_MODE_HOST_SHA256=replace-with-approved-lowercase-sha256
BALCONY_DISPATCHER_CODEX_HOME=C:\path\to\dedicated-codex-home
BALCONY_DISPATCHER_TRUSTED_PATH=C:\path\to\trusted-node-directory
BALCONY_DISPATCHER_POLL_INTERVAL_MS=2000
BALCONY_DISPATCHER_DEFAULT_TIMEOUT_SECONDS=300
BALCONY_DISPATCHER_MAX_OUTPUT_BYTES=48000
BALCONY_DISPATCHER_NOT_BEFORE_UTC=replace-with-utc-timestamp
BALCONY_DISPATCHER_MODE=legacy
# consultation mode additionally requires the three values below.
# BALCONY_CONSULTATION_WORKING_DIRECTORY=C:\path\to\neutral-working-directory
# BALCONY_GIT_EXECUTABLE=C:\path\to\approved-git.exe
# BALCONY_GIT_EXECUTABLE_SHA256=replace-with-approved-lowercase-sha256
