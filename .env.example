# Bridge-service example only. Do not source this file into MCP or dispatcher.
BALCONY_SYSTEM_ID=node-a
BALCONY_AUTHORIZED_NODE_IDS=node-b,node-c
BALCONY_BRIDGE_DB_PATH=C:\path\to\agent-bridge\data\bridge.sqlite3
BALCONY_SERVICEBUS_NAMESPACE=replace-with-approved.servicebus.windows.net
BALCONY_SERVICEBUS_TOPIC=agent-messages
BALCONY_SERVICEBUS_SUBSCRIPTION=node-a
BALCONY_AZURE_AUTH_MODE=managed_identity
BALCONY_MANAGED_IDENTITY_CLIENT_ID=11111111-1111-4111-8111-111111111111
# For approved client_certificate mode, remove the managed-identity client ID
# and supply tenant ID, client ID, and an absolute certificate path instead.
# BALCONY_AZURE_TENANT_ID=11111111-1111-4111-8111-111111111111
# BALCONY_AZURE_CLIENT_ID=22222222-2222-4222-8222-222222222222
# BALCONY_AZURE_CLIENT_CERTIFICATE_PATH=C:\path\to\client-certificate.pem
BALCONY_MESSAGE_AUTH_MODE=ed25519
BALCONY_MESSAGE_AUTH_MEMBERSHIP_PATH=C:\path\to\agent-bridge\auth\membership.json
BALCONY_MESSAGE_AUTH_SIGNING_KEY_PATH=C:\path\to\agent-bridge\auth\node-identity.pkcs8.pem
