BALCONY_SERVICEBUS_TOPIC=agent-messages
BALCONY_SERVICEBUS_SUBSCRIPTION=sys-a
BALCONY_DISPATCHER_PROJECTS_PATH=C:\ProgramData\Balcony\AgentBridge\config\dispatcher-projects.json
