{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neel-Error404/balcony-agent-bridge/docs/contracts/artifact-release.v1.schema.json",
  "title": "Balcony Git Artifact Release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_protocol",
    "release_id",
    "release_date_utc",
    "artifact_type",
    "origin_system",
    "target_system",
    "created_at_utc",
    "archive",
    "skills",
    "install_policy",
    "declared_name_exceptions"
  ],
  "properties": {
    "schema_version": { "const": "balcony-artifact-release.v1" },
    "handoff_protocol": { "const": "balcony-git-artifact-handoff.v1" },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}--sys-[ab]-to-sys-[ab]--codex-skills--r[0-9]{2}$"
    },
    "release_date_utc": { "type": "string", "format": "date" },
    "artifact_type": { "const": "codex-skill-archive" },
    "origin_system": { "enum": ["SYS-A", "SYS-B"] },
    "target_system": { "enum": ["SYS-A", "SYS-B"] },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_name",
        "sha256",
        "byte_length",
        "payload_root",
        "zip_entry_count",
        "file_entry_count",
        "directory_entry_count",
        "payload_file_count",
        "uncompressed_byte_length",
        "max_file_byte_length",
        "metadata_files"
      ],
      "properties": {
        "file_name": { "const": "payload.zip" },
        "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "payload_root": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$" },
        "zip_entry_count": { "type": "integer", "minimum": 1 },
        "file_entry_count": { "type": "integer", "minimum": 1 },
        "directory_entry_count": { "type": "integer", "minimum": 0 },
        "payload_file_count": { "type": "integer", "minimum": 1 },
        "uncompressed_byte_length": { "type": "integer", "minimum": 1, "maximum": 52428800 },
        "max_file_byte_length": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "metadata_files": {
          "type": "array",
          "const": ["README.md", "MANIFEST.md", "SHA256SUMS.txt"]
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "agents"],
      "properties": {
        "codex": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" } },
        "agents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" } }
      }
    },
    "install_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collision", "require_git_commit_pin", "require_target_system_identity"],
      "properties": {
        "collision": { "const": "accept-identical-or-fail" },
        "require_git_commit_pin": { "const": true },
        "require_target_system_identity": { "const": true }
      }
    },
    "declared_name_exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "directory", "declared_name", "reason"],
        "properties": {
          "surface": { "enum": ["codex", "agents"] },
          "directory": { "type": "string" },
          "declared_name": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
